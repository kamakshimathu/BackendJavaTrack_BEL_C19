# Copy this file to ".env" and fill in your real values.
#   cp .env.example .env        (macOS / Linux)
#   Copy-Item .env.example .env (Windows PowerShell)
#
# .env is git-ignored so your key is never committed.

OPENAI_API_KEY=sk-your-openai-key-here

# Optional — defaults to gpt-4o-mini if unset.
# OPENAI_MODEL=gpt-4o

# Milestone 4 MCP filesystem server.
# Root is resolved by filesystem_mcp_server.py; "." means this project folder
# when the server is launched from llm-file-tools.
FILESYSTEM_MCP_ROOT=.
FILESYSTEM_MCP_ALLOW_WRITE=false
FILESYSTEM_MCP_MAX_FILE_BYTES=5000000
FILESYSTEM_MCP_MAX_BATCH_FILES=50
FILESYSTEM_MCP_WATCH_MAX_SECONDS=30
FILESYSTEM_MCP_TRANSPORT=stdio
