NODE_ENV=development
PORT=3000
# Replace placeholders with confirmed details for an existing PostgreSQL database.
# Percent-encode special characters in the username and password.
DATABASE_URL="postgresql://YOUR_USER:YOUR_PASSWORD@localhost:5432/YOUR_DATABASE?schema=public"
CORS_ORIGIN=http://localhost:5173
# Generate at least 32 random bytes as hexadecimal; do not use this placeholder.
JWT_SECRET=REPLACE_WITH_PRIVATE_RANDOM_HEX_SECRET
JWT_ISSUER=task-tracker-api
JWT_AUDIENCE=task-tracker-client
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7
# Optional: a SEPARATE, disposable PostgreSQL database for integration tests.
# TEST_DATABASE_URL=postgresql://YOUR_USER:YOUR_PASSWORD@localhost:5432/task_tracker_test
